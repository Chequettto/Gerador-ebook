# ==========================================================
# Pools de chaves: cada provedor aceita sufixos de 1 a 100
# Preencha com suas chaves reais no Render (Environment tab)
# ou em um arquivo .env local (NUNCA versionado no git).
# ==========================================================

# --- Gemini ---
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Pools aceitam sufixos de 1 a 100. Modelos padrão podem ser sobrescritos:
# GEMINI_MODEL=
# GEMINI_COMPLEX_MODEL=

# --- Groq ---
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=
GROQ_KEY_5=
GROQ_KEY_6=
# GROQ_MODEL=
# GROQ_COMPLEX_MODEL=

# --- Mistral ---
MISTRAL_KEY_1=
MISTRAL_KEY_2=
MISTRAL_KEY_3=
MISTRAL_KEY_4=
MISTRAL_KEY_5=
MISTRAL_KEY_6=
# MISTRAL_MODEL=
# MISTRAL_COMPLEX_MODEL=

# Porta (o Render injeta isso automaticamente, não precisa setar em produção)
PORT=3000

# Origem(ns) permitida(s) para CORS, separadas por vírgula. Use "*" para liberar geral.
CORS_ORIGIN=*

# --- Login simples por e-mail ---
DATABASE_URL=
DATABASE_SSL=false
AUTH_SESSION_SECRET=
ADMIN_EMAIL=
# Endereços públicos do proprietário com geração ilimitada, separados por vírgula.
ADMIN_IPS=
# Em produção no Render, o servidor confia em um proxy à frente para obter o IP real.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Pagamento (Asaas) ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Defina apenas no ambiente privado do Render e compartilhe com os destinatários autorizados.
PRIVATE_COUPON_CODE=
# Opcional: use https://api-sandbox.asaas.com/v3 para testar sem cobrar de verdade
ASAAS_BASE_URL=https://api.asaas.com/v3

# --- Reservas extras opcionais (sem cartão) ---
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_KEY_1=
# OPENROUTER_COMPLEX_MODEL=
# Opcional: trocar o modelo grátis se o padrão sair do ar
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Cloudflare Workers AI: precisa do Account ID (não secreto) + token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KEY_1=
# CLOUDFLARE_COMPLEX_MODEL=
# Opcional: trocar o modelo
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Research Engine (opcional) ---
# A maioria das fontes (Wikipedia, Wikidata, OpenAlex, Crossref, Open
# Library, Gutenberg, Internet Archive) não precisa de chave nenhuma.
# Só o Europeana precisa — grátis em https://apikey.europeana.eu/
# Se não configurar, o Europeana é pulado automaticamente, sem quebrar nada.
EUROPEANA_API_KEY=

# Quantos dias o cache de pesquisa fica válido antes de pesquisar de novo.
RESEARCH_CACHE_TTL_DAYS=30
